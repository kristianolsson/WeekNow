        <!-- Two pins in dark greyish-teal -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#2D3330"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:pathData="M38,17 v10 M70,17 v10" />

        <!-- W in dark greyish-teal - Reduced stroke (7.5) -->
