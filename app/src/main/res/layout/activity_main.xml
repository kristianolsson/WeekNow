<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp">

    <!-- ── TOP: fills all remaining space, centers content ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/labelCurrentWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_current_week"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textWeekNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="96sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

    </LinearLayout>

    <!-- ── BOTTOM: settings cards, anchored to bottom ── -->

    <!-- 1. Status bar icon toggle -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="0dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/toggle_label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Switch
                android:id="@+id/switchEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. Icon size — S/M/L, same total width as Mon/Sun below -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="0dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/icon_size_label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleIconSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <!-- minWidth="0dp" removes Material's hidden minimum so buttons can be compact -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSizeSmall"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    app:minWidth="0dp"
                    android:text="@string/size_s"
                    android:textSize="13sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSizeMedium"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    app:minWidth="0dp"
                    android:text="@string/size_m"
                    android:textSize="13sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSizeLarge"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    app:minWidth="0dp"
                    android:text="@string/size_l"
                    android:textSize="13sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. First day of week — Mon/Sun -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/first_day_label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleFirstDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonday"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    app:minWidth="0dp"
                    android:text="@string/monday"
                    android:textSize="13sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSunday"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    app:minWidth="0dp"
                    android:text="@string/sunday"
                    android:textSize="13sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
